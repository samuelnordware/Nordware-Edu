# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Use a chave publica (publishable/anon).
# NUNCA use a chave service_role / secret no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica

# "false" esconde a opcao "Criar conta" na tela de login
VITE_ALLOW_SIGNUP=true
